@model SafePathBD.Web.Models.DTOs.Dashboard.AdminDashboardDto
@{
    ViewData["Title"] = "Admin";
    var counts = Model.ReportCounts;
    var totalReports = Model.AccidentReports + Model.HazardReports;
    var accidentPercent = totalReports == 0 ? 0 : (int)Math.Round(Model.AccidentReports * 100d / totalReports);
    var hazardPercent = totalReports == 0 ? 0 : 100 - accidentPercent;

    string ActionLabel(string type) => type switch
    {
        AdminActionTypes.ReportVerified => "Verified a report",
        AdminActionTypes.ReportRejected => "Rejected a report",
        AdminActionTypes.ReportMarkedDuplicate => "Marked a report duplicate",
        AdminActionTypes.ReportNeedsInfo => "Requested more information",
        AdminActionTypes.ReportResolved => "Resolved a report",
        AdminActionTypes.ReportUnderReview => "Started a review",
        AdminActionTypes.AccidentPromoted => "Promoted a trusted accident",
        _ => "Changed a report status"
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel
{
    Eyebrow = "Administration",
    Title = "Operational overview",
    Description = "Real platform counts, report distribution, queue pressure and privileged activity.",
    Chips = new[] { new PageHeaderChip("Administrator", "chip--accent") }
})" />

<section class="section section--tight">
    <div class="shell admin-grid">
        <nav class="side-nav" aria-label="Admin sections">
            <a class="side-nav-item is-active" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Overview</a>
            <a class="side-nav-item" asp-area="Admin" asp-controller="ModeratorDashboard" asp-action="Index">Moderation overview</a>
            <a class="side-nav-item" asp-area="Admin" asp-controller="ReportModeration" asp-action="Index">
                Report verification
                @if (counts.OpenTotal > 0) { <span class="chip chip--accent chip--plain">@counts.OpenTotal</span> }
            </a>
            <span class="side-nav-item is-soon">Users &amp; roles <span class="chip chip--muted chip--plain">Later</span></span>
            <span class="side-nav-item is-soon">Road safety engine <span class="chip chip--muted chip--plain">Second half</span></span>
        </nav>

        <div class="stack-5">
            <section class="admin-metric-band">
                <div class="admin-metric-main">
                    <span class="t-eyebrow">Registered users</span>
                    <strong data-countup="@Model.TotalUsers">@Model.TotalUsers</strong>
                    <small>@Model.ActiveUsers active accounts</small>
                </div>
                <div class="admin-metric-grid">
                    <a asp-controller="ReportModeration" asp-action="Index" asp-route-status="@ReportStatusCodes.Pending"><strong data-countup="@counts.Pending">@counts.Pending</strong><span>Pending</span></a>
                    <a asp-controller="ReportModeration" asp-action="Index" asp-route-status="@ReportStatusCodes.Verified"><strong data-countup="@counts.Verified">@counts.Verified</strong><span>Verified</span></a>
                    <a asp-controller="ReportModeration" asp-action="Index" asp-route-status="@ReportStatusCodes.Rejected"><strong data-countup="@counts.Rejected">@counts.Rejected</strong><span>Rejected</span></a>
                    <a asp-controller="ReportModeration" asp-action="Index" asp-route-status="@ReportStatusCodes.NeedsInfo"><strong data-countup="@counts.NeedsInfo">@counts.NeedsInfo</strong><span>Needs info</span></a>
                </div>
            </section>

            <div class="ops-grid">
                <section class="panel">
                    <div class="dashboard-section-head">
                        <div><span class="t-eyebrow">Report mix</span><h2 class="t-h3">Accident vs hazard</h2></div>
                        <span class="t-meta">@totalReports total</span>
                    </div>
                    @if (totalReports == 0)
                    {
                        <div class="empty-state"><p class="t-body">No reports have been submitted yet.</p></div>
                    }
                    else
                    {
                        <div class="distribution-row"><span>Accident</span><strong>@Model.AccidentReports</strong><div><i style="width:@accidentPercent%"></i></div><small>@accidentPercent%</small></div>
                        <div class="distribution-row"><span>Hazard</span><strong>@Model.HazardReports</strong><div><i style="width:@hazardPercent%"></i></div><small>@hazardPercent%</small></div>
                    }
                </section>

                <section class="panel">
                    <div class="dashboard-section-head"><div><span class="t-eyebrow">Recent activity</span><h2 class="t-h3">Admin audit</h2></div></div>
                    @if (Model.RecentActions.Count == 0)
                    {
                        <div class="empty-state"><p class="t-body">No privileged action has been recorded yet.</p></div>
                    }
                    else
                    {
                        <div class="dashboard-timeline compact">
                            @foreach (var entry in Model.RecentActions)
                            {
                                <div class="dashboard-timeline-item">
                                    <span class="dashboard-timeline-dot" aria-hidden="true"></span>
                                    <div><strong>@ActionLabel(entry.ActionType)</strong><p>@(entry.ActorName ?? "Removed account")</p><span class="t-micro t-muted">@entry.ActionAt.ToString("d MMM yyyy, HH:mm")</span></div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>

            <section class="panel">
                <div class="dashboard-section-head">
                    <div><span class="t-eyebrow">Review pressure</span><h2 class="t-h3">Queue preview</h2></div>
                    <a class="btn btn-primary" asp-controller="ReportModeration" asp-action="Index">Open review queue</a>
                </div>
                @if (Model.QueuePreview.Count == 0)
                {
                    <div class="empty-state"><h3 class="t-h3">All caught up</h3><p class="t-body">There are no reports waiting for review.</p></div>
                }
                else
                {
                    <div class="ops-queue-list">
                        @foreach (var report in Model.QueuePreview)
                        {
                            <a class="ops-queue-item" asp-controller="ReportModeration" asp-action="Review" asp-route-id="@report.ReportId">
                                <span class="ops-queue-type">@(report.ReportType == ReportTypes.Accident ? "Accident" : "Hazard")</span>
                                <div><strong>@report.Title</strong><p>@(report.AreaName ?? report.City ?? "Location recorded") · @report.ReportedAt.ToString("d MMM, HH:mm")</p></div>
                                <partial name="_ReportStatusChip" model="@((report.StatusCode, report.StatusName))" />
                            </a>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true" defer></script>
}

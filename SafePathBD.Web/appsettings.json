{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.SafePathBD.OSRM": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Geocoding": {
    "Nominatim": {
      "BaseUrl": "https://nominatim.openstreetmap.org/",
      "UserAgent": "SafePathBD/1.0 (academic project; contact: set-your-email)",
      "CountryCodes": "bd",
      "Language": "en",
      "TimeoutSeconds": 8,
      "MaxResults": 8
    }
  },
  "Routing": {
    "Provider": "OSRM",
    "OSRM": {
      "BaseUrl": "https://router.project-osrm.org/",
      "Profile": "driving",
      "TimeoutSeconds": 12,
      "CacheMinutes": 20,
      "IncidentRecheckSeconds": 60,
      "IncidentProximityMeters": 50,
      "DetourFallbackEnabled": true,
      "DetourOffsetMeters": 600,
      "MaxDetourAttempts": 4,
      "MaxDetourDistanceFactor": 1.75,
      "CautionAlternativeDistanceFactor": 1.25
    }
  },
  "IntelligentMobility": {
    "TrafficDatasetPath": "Data/Traffic/aust_10km_synthetic_traffic_development.csv",
    "TrafficRoadMappingPath": "Data/Traffic/traffic_road_mapping.csv",
    "TransitDataPath": "Data/Transit",
    "TrafficModelPath": "ML/Models/traffic-congestion-model.zip",
    "TrafficModelMetadataPath": "ML/Models/traffic-model-metadata.json",
    "DefaultWeatherCondition": "Clear",
    "TrafficPredictionCacheMinutes": 30,
    "TrafficRoadMatchMaxMeters": 1200,
    "GraphSampleMeters": 220,
    "BusStopMatchMeters": 500,
    "CandidatePoolSize": 12,
    "TopJourneyCount": 3,
    "DiversityThreshold": 0.9,
    "BackupDiversityThreshold": 0.8,
    "DefaultMaxTransfers": 2,
    "DefaultMaxWalkingMeters": 1000,
    "MaximumWalkingMeters": 2000,
    "GenericTransferMinutes": 1.5,
    "BusTransferMinutes": 2.0,
    "UnknownDataPenalty": 8.0,
    "DepartureBenefitMinutes": 5.0,
    "DepartureBenefitPercent": 0.08,
    "IntelligentSearchCacheMinutes": 20,
    "MaxDepartureHoursAhead": 168,
    "BusStopDwellMinutes": 0.6
  }
}
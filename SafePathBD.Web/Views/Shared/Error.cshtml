@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="status-page shell">
    <div class="status-page-inner">
        <span class="status-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 8v5M12 16.5h.01" />
                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
            </svg>
        </span>

        <h1 class="t-h1">We couldn't complete that request</h1>
        <p class="t-lead" style="text-align: center;">
            An unexpected error occurred on our side. Nothing was changed. Please try again, and
            let us know if it keeps happening.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="t-meta">Reference: <span style="font-family: var(--font-mono);">@Model.RequestId</span></p>
        }

        <div class="cluster" style="justify-content: center; margin-top: var(--space-3);">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
        </div>
    </div>
</div>

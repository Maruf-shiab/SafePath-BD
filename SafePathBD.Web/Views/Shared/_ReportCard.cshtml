@model SafePathBD.Web.Models.DTOs.Reports.ReportSummaryDto
@{
    var isAccident = Model.ReportType == ReportTypes.Accident;

    var accent = isAccident
        ? Model.SeverityName switch
        {
            "Minor" => "var(--caution)",
            "Moderate" => "var(--warning)",
            "Severe" => "var(--danger)",
            "Fatal" => "var(--report-fatal)",
            _ => "var(--warning)"
        }
        : Model.RiskLevel switch
        {
            "LOW" => "var(--safe)",
            "MODERATE" => "var(--caution)",
            "HIGH" => "var(--warning)",
            "CRITICAL" => "var(--danger)",
            _ => "var(--caution)"
        };

    var subtype = isAccident
        ? string.Join(" · ", new[] { Model.AccidentTypeName, Model.SeverityName }.Where(v => !string.IsNullOrWhiteSpace(v)))
        : string.Join(" · ", new[] { Model.HazardTypeName, Model.RiskLevel }.Where(v => !string.IsNullOrWhiteSpace(v)));

    var place = Model.AreaName ?? Model.City;
    var age = (DateTime.Now - Model.ReportedAt).TotalHours;
    var when = age < 1 ? "Just now"
        : age < 24 ? $"{(int)age} h ago"
        : Model.ReportedAt.ToString("d MMM yyyy");
}

<a class="report-card" asp-controller="Reports" asp-action="Details" asp-route-id="@Model.ReportId" style="--report-color: @accent">
    <span class="report-glyph" aria-hidden="true">
        @if (isAccident)
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 16.5V13l1.8-4.2A2 2 0 0 1 7.7 7.5h8.6a2 2 0 0 1 1.9 1.3L20 13v3.5" />
                <path d="M4 16.5h16M6.8 16.5v2M17.2 16.5v2M7.5 12.7h9" />
            </svg>
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 9.2v4M12 16.4h.01" />
                <path d="M10.3 4.4 2.6 17.6a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z" />
            </svg>
        }
    </span>

    <span class="report-card-body">
        <span class="report-card-title">@Model.Title</span>
        <span class="report-card-meta">
            <span>@(isAccident ? "Accident" : "Hazard")</span>
            @if (!string.IsNullOrWhiteSpace(subtype))
            {
                <span>@subtype</span>
            }
            @if (!string.IsNullOrWhiteSpace(place))
            {
                <span>@place</span>
            }
            <span>@when</span>
            @if (Model.ImageCount > 0)
            {
                <span>@Model.ImageCount photo@(Model.ImageCount == 1 ? "" : "s")</span>
            }
        </span>
    </span>

    @if (Model.ThumbnailImageId is not null)
    {
        <img class="report-card-thumb" src="@Url.Action("Image", "Reports", new { id = Model.ThumbnailImageId })" alt="" loading="lazy" />
    }

    <partial name="_ReportStatusChip" model="@((Model.StatusCode, Model.StatusName))" />
</a>

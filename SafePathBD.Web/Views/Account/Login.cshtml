@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var statusMessage = TempData["StatusMessage"] as string;
}

<div class="auth-layout">
    <aside class="auth-aside">
        <div class="grid-backdrop" aria-hidden="true"></div>
        <div class="auth-aside-content stack-5">
            <span class="t-eyebrow">Welcome back</span>
            <h1 class="t-h1">Your routes, reports and alerts are waiting.</h1>
            <p class="t-lead">
                Sign in to submit road reports, follow their verification status and get
                safety-aware route recommendations.
            </p>

            <ul class="stack-3" style="margin-top: var(--space-2);">
                <li class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Report accidents and hazards from the map
                </li>
                <li class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Save places and preferred routes
                </li>
                <li class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Get notified when a report is reviewed
                </li>
            </ul>
        </div>
    </aside>

    <div class="auth-panel">
        <div class="auth-card panel">
            <div class="stack-2" style="margin-bottom: var(--space-6);">
                <span class="t-eyebrow">Account access</span>
                <h2 class="t-h2">Sign in</h2>
                <p class="t-meta">New to SafePath BD? <a class="t-accent" asp-action="Register">Create an account</a>.</p>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert--success" role="status" style="margin-bottom: var(--space-5);">@statusMessage</div>
            }

            <form method="post" asp-action="Login" asp-route-returnUrl="@returnUrl" class="stack-5" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert--error" role="alert"></div>

                <div class="field">
                    <label class="field-label" asp-for="Email"></label>
                    <div class="field-control">
                        <input class="input" asp-for="Email" autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <span class="field-error" asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Password"></label>
                    <div class="field-control">
                        <input class="input" asp-for="Password" id="loginPassword" autocomplete="current-password" placeholder="Your password" />
                        <button class="input-toggle" type="button" data-password-toggle="loginPassword" aria-label="Show password" aria-pressed="false">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.8-7 10-7 10 7 10 7-3.8 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" asp-validation-for="Password"></span>
                </div>

                <label class="checkbox">
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in</span>
                </label>

                <button class="btn btn-primary btn-block btn-lg" type="submit">Sign in</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

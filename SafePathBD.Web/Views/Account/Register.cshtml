@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-layout">
    <aside class="auth-aside">
        <div class="grid-backdrop" aria-hidden="true"></div>
        <div class="auth-aside-content stack-5">
            <span class="t-eyebrow">Join SafePath BD</span>
            <h1 class="t-h1">Help make the roads you use safer.</h1>
            <p class="t-lead">
                An account lets you contribute road reports and receive route recommendations that
                account for accident history, hazards, road condition, traffic, weather and lighting.
            </p>

            <div class="card" style="background: rgba(255,255,255,0.03);">
                <h3 class="t-h3 card-title">What we store</h3>
                <p class="t-body">
                    Your name, email and optional phone number. Passwords are stored only as a secure
                    hash, and location is captured per action — never continuously.
                </p>
            </div>
        </div>
    </aside>

    <div class="auth-panel">
        <div class="auth-card panel">
            <div class="stack-2" style="margin-bottom: var(--space-6);">
                <span class="t-eyebrow">New account</span>
                <h2 class="t-h2">Create your account</h2>
                <p class="t-meta">Already registered? <a class="t-accent" asp-action="Login">Sign in instead</a>.</p>
            </div>

            <form method="post" asp-action="Register" class="stack-5" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert--error" role="alert"></div>

                <div class="field">
                    <label class="field-label" asp-for="FullName"></label>
                    <div class="field-control">
                        <input class="input" asp-for="FullName" autocomplete="name" placeholder="e.g. Rafiq Ahmed" />
                    </div>
                    <span class="field-error" asp-validation-for="FullName"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Email"></label>
                    <div class="field-control">
                        <input class="input" asp-for="Email" autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <span class="field-error" asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Phone"></label>
                    <div class="field-control">
                        <input class="input" asp-for="Phone" autocomplete="tel" placeholder="+8801XXXXXXXXX" />
                    </div>
                    <span class="field-hint">Optional. Used only for account recovery and emergency contact features.</span>
                    <span class="field-error" asp-validation-for="Phone"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="Password"></label>
                    <div class="field-control">
                        <input class="input" asp-for="Password" id="registerPassword" autocomplete="new-password" placeholder="At least 8 characters" />
                        <button class="input-toggle" type="button" data-password-toggle="registerPassword" aria-label="Show password" aria-pressed="false">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3.8-7 10-7 10 7 10 7-3.8 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span class="field-error" asp-validation-for="Password"></span>
                </div>

                <div class="field">
                    <label class="field-label" asp-for="ConfirmPassword"></label>
                    <div class="field-control">
                        <input class="input" asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repeat your password" />
                    </div>
                    <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                </div>

                <button class="btn btn-primary btn-block btn-lg" type="submit">Create account</button>

                <p class="t-meta">
                    New accounts receive the standard <strong>User</strong> role. Moderator and administrator
                    access is granted by an administrator.
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

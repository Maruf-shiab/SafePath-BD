@using System.Text.Json
@model SafePathBD.Web.Models.ViewModels.Map.MapPageViewModel
@{
    ViewData["Title"] = "Map";
    ViewData["FullBleed"] = true;

    var mapConfig = JsonSerializer.Serialize(new
    {
        lat = Model.DefaultLatitude,
        lng = Model.DefaultLongitude,
        zoom = Model.DefaultZoom
    });
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var mapLoginUrl = Url.Action("Login", "Account", new { returnUrl = "/Map" }) ?? "/Account/Login?returnUrl=%2FMap";
}

@section Head {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/css/map.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/routing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/intelligent-routing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/saved-places.css" asp-append-version="true" />
}

<div class="map-workspace" data-map-root data-map-config="@mapConfig"
     data-user-authenticated="@(isAuthenticated.ToString().ToLowerInvariant())"
     data-map-login-url="@mapLoginUrl">
    <form data-routing-antiforgery hidden aria-hidden="true">
        @Html.AntiForgeryToken()
    </form>
    <div class="map-canvas" data-map-canvas role="application" aria-label="SafePath BD interactive map"></div>

    <div class="map-loading" data-map-loading>
        <div class="map-loading-inner">
            <svg viewBox="0 0 132 44" aria-hidden="true">
                <path d="M4 34C24 34 30 10 52 10s28 24 48 24h28" />
            </svg>
            <p class="t-meta">Loading the SafePath map…</p>
        </div>
    </div>

    @* Journey planning panel *@
    <section class="map-layer map-panel map-panel--search" aria-label="Plan a journey">
        <div class="map-panel-head">
            <span class="t-eyebrow">Plan a journey</span>
            <button class="map-control" type="button" data-swap title="Swap start and destination" aria-label="Swap start and destination" style="width:32px;height:32px;box-shadow:none;background:transparent;backdrop-filter:none">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 4v13M7 4 4 7M7 4l3 3M17 20V7M17 20l3-3M17 20l-3-3" />
                </svg>
            </button>
        </div>

        <div class="route-fields">
            <div class="route-field" data-place-field="start">
                <span class="route-field-dot" aria-hidden="true"></span>
                <div class="place-input-shell">
                    <label class="visually-hidden" for="startPlace">Start location</label>
                    <input class="input" id="startPlace" type="text" placeholder="Choose a start point"
                           autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" />
                    <button class="save-place-trigger" type="button" data-save-place-role="start" title="Save this start location" aria-label="Save start location">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z" /></svg>
                    </button>
                    <div class="suggest" data-suggest role="listbox" aria-label="Start location suggestions"></div>
                </div>
            </div>

            <div class="route-field route-field--end" data-place-field="end">
                <span class="route-field-dot" aria-hidden="true"></span>
                <div class="place-input-shell">
                    <label class="visually-hidden" for="endPlace">Destination</label>
                    <input class="input" id="endPlace" type="text" placeholder="Choose a destination"
                           autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" />
                    <button class="save-place-trigger" type="button" data-save-place-role="end" title="Save this destination" aria-label="Save destination">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z" /></svg>
                    </button>
                    <div class="suggest" data-suggest role="listbox" aria-label="Destination suggestions"></div>
                </div>
            </div>
        </div>

        <section class="saved-places" data-saved-places aria-label="Saved places">
            <div class="saved-places__head">
                <strong>Saved places</strong>
                <span data-saved-place-status>@(isAuthenticated ? "Loading…" : "Login required")</span>
            </div>
            <div class="saved-place-list" data-saved-place-list>
                @if (isAuthenticated)
                {
                    <div class="saved-place-loading"><i aria-hidden="true"></i><span>Loading saved places…</span></div>
                }
                else
                {
                    <div class="saved-place-login">
                        <span>Home, Work and personal bookmarks are available after sign in.</span>
                        <small>Saved locations can be used instantly as either the route start or destination.</small>
                        <a data-saved-login href="@mapLoginUrl">Sign in to use saved places</a>
                    </div>
                }
            </div>
        </section>

        <div class="route-actions">
            <button class="btn btn-secondary" type="button" data-use-current-start>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="3.2" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
                </svg>
                <span>My location</span>
            </button>
            <button class="btn btn-primary" type="button" data-find-routes disabled
                    title="Choose a start and destination first">
                <span data-find-routes-label>Find routes</span>
            </button>
        </div>

        <div class="smart-journey" data-intelligent-controls>
            <div class="smart-journey__head">
                <div>
                    <span class="t-eyebrow">SafePath intelligence</span>
                    <p class="t-meta">Compare practical multimodal journeys with predicted traffic and verified road incidents.</p>
                </div>
                <span class="smart-journey__badge">Synthetic traffic prototype</span>
            </div>

            <div class="smart-journey__grid">
                <fieldset class="smart-fieldset">
                    <legend>Travel modes</legend>
                    <div class="mode-pills" data-mode-pills>
                        <label><input type="checkbox" value="WALK" checked /><span>Walk</span></label>
                        <label><input type="checkbox" value="RICKSHAW" checked /><span>Rickshaw</span></label>
                        <label><input type="checkbox" value="BUS" checked /><span>Bus</span></label>
                        <label><input type="checkbox" value="MOTORBIKE" checked /><span>Motorbike</span></label>
                        <label><input type="checkbox" value="CAR" /><span>Car</span></label>
                    </div>
                </fieldset>

                <label class="smart-control">
                    <span>Preference</span>
                    <select class="input" data-journey-preference>
                        <option value="BALANCED">Balanced</option>
                        <option value="SAFETY_FIRST">Safety first</option>
                        <option value="FASTEST_PRACTICAL">Fastest practical</option>
                        <option value="LESS_WALKING">Less walking</option>
                        <option value="FEWER_TRANSFERS">Fewer transfers</option>
                    </select>
                </label>

                <label class="smart-control">
                    <span>Maximum walking</span>
                    <select class="input" data-max-walking>
                        <option value="0">No walking</option>
                        <option value="500">500 m</option>
                        <option value="1000" selected>1 km</option>
                        <option value="2000">2 km</option>
                    </select>
                </label>

                <label class="smart-control">
                    <span>Maximum transfers</span>
                    <select class="input" data-max-transfers>
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2" selected>2</option>
                    </select>
                </label>

                <div class="smart-control smart-control--departure">
                    <span>Departure</span>
                    <label class="smart-toggle"><input type="checkbox" data-leave-now checked /><span>Leave now</span></label>
                    <input class="input" type="datetime-local" data-departure-time disabled aria-label="Custom departure time" />
                </div>
            </div>

            <button class="btn btn-primary smart-journey__plan" type="button" data-plan-intelligent disabled>
                <span data-plan-intelligent-label>Plan smart journey</span>
            </button>
            <p class="smart-journey__disclaimer">Predicted traffic uses the supplied synthetic SafePath development patterns. It is not measured live traffic. Safety output uses verified incidents and any available mapped safety data.</p>
        </div>

        <p class="map-note" data-route-hint>
            Use <strong>Find routes</strong> for the Chunk 6 road alternatives, or <strong>Plan smart journey</strong> for multimodal traffic-aware recommendations.
        </p>
    </section>

    @* Floating controls *@
    <div class="map-layer map-controls">
        <button class="map-control" type="button" data-locate title="Use my location" aria-label="Use my location">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3.2" /><circle cx="12" cy="12" r="8" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3" />
            </svg>
        </button>
        <button class="map-control is-active" type="button" data-toggle-emergency aria-pressed="true"
                title="Toggle emergency services layer" aria-label="Toggle emergency services layer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 7v10M7 12h10" /><rect x="3.5" y="3.5" width="17" height="17" rx="4" />
            </svg>
        </button>
        <button class="map-control" type="button" data-toggle-reports aria-pressed="false"
                title="Toggle verified accident and hazard reports" aria-label="Toggle verified accident and hazard reports">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9.2v4M12 16.4h.01" />
                <path d="M10.3 4.4 2.6 17.6a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z" />
            </svg>
        </button>
        <button class="map-control" type="button" data-reset-view title="Reset the view" aria-label="Reset the view">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 2.6-6.4M3 4v5h5" />
            </svg>
        </button>
    </div>

    @* Emergency type filters *@
    <div class="map-layer map-filters" id="emergency" role="group" aria-label="Emergency service type">
        <button class="filter-chip is-active" type="button" data-filter="all" aria-pressed="true"
                style="--chip-dot: var(--accent-primary)">All</button>
        @foreach (var type in Model.ServiceTypes)
        {
            // Short labels keep the chip row on one line; the filter value stays the exact database name.
            var (dot, label) = type switch
            {
                "Hospital" => ("var(--svc-hospital)", "Hospitals"),
                "Police Station" => ("var(--svc-police)", "Police"),
                "Fire Service" => ("var(--svc-fire)", "Fire"),
                "Ambulance" => ("var(--svc-ambulance)", "Ambulance"),
                _ => ("var(--svc-center)", "Emergency")
            };
            <button class="filter-chip" type="button" data-filter="@type" aria-pressed="false"
                    title="@type" aria-label="Show @type" style="--chip-dot: @dot">@label</button>
        }
    </div>

    @* Selected point context card *@
    <div class="map-layer point-card" data-point-card hidden>
        <span class="t-eyebrow">Selected point</span>
        <p class="t-body" data-point-title style="margin-top: var(--space-2);"></p>
        <p class="point-coords" data-point-coords></p>
        <div class="point-actions">
            <button class="btn btn-secondary" type="button" data-set-start>Set as start</button>
            <button class="btn btn-secondary" type="button" data-set-end>Set as destination</button>
            <button class="btn btn-secondary" type="button" data-save-picked-place>Save place</button>
            <button class="btn btn-ghost" type="button" data-point-dismiss aria-label="Dismiss selected point">Clear</button>
        </div>
    </div>

    <dialog class="saved-place-dialog" data-saved-place-dialog aria-labelledby="savedPlaceTitle">
        <form class="saved-place-dialog__form" data-saved-place-form>
            <div class="saved-place-dialog__head">
                <div>
                    <h3 class="t-h3" id="savedPlaceTitle">Save this location</h3>
                    <p class="saved-place-dialog__preview" data-saved-place-preview></p>
                </div>
                <button class="saved-place-dialog__close" type="button" data-saved-place-dialog-close aria-label="Close save location dialog">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <div class="saved-place-dialog__grid">
                <label>
                    <span>Type</span>
                    <select class="input" data-saved-place-type>
                        <option value="HOME">Home</option>
                        <option value="OFFICE">Work</option>
                        <option value="UNIVERSITY">University</option>
                        <option value="FAVORITE" selected>Bookmark</option>
                        <option value="OTHER">Other</option>
                    </select>
                </label>
                <label>
                    <span>Name</span>
                    <input class="input" type="text" maxlength="120" data-saved-place-name placeholder="Bookmark name" autocomplete="off" />
                </label>
            </div>
            <p class="t-meta" style="margin:0">Saving Home or Work again updates that shortcut. Custom bookmarks can be saved with different names.</p>
            <div class="saved-place-dialog__actions">
                <button class="btn btn-secondary" type="button" data-saved-place-cancel>Cancel</button>
                <button class="btn btn-primary" type="submit" data-saved-place-submit>Save location</button>
            </div>
        </form>
    </dialog>

    @* Results / detail drawer — bottom sheet on mobile *@
    <aside class="map-layer map-drawer" data-drawer aria-hidden="true" aria-label="Map results and route alternatives">
        <span class="drawer-handle" aria-hidden="true"></span>
        <div class="drawer-head">
            <div>
                <h2 class="t-h3" data-drawer-title>Emergency services</h2>
                <p class="t-meta" data-drawer-subtitle></p>
            </div>
            <button class="drawer-close" type="button" data-drawer-close aria-label="Close panel">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>
        </div>
        <div class="drawer-body" data-drawer-body></div>
    </aside>
</div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/js/safepath-map.js" asp-append-version="true"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/saved-places.js" asp-append-version="true"></script>
    <script src="~/js/routing.js" asp-append-version="true"></script>
    <script src="~/js/intelligent-routing.js" asp-append-version="true"></script>
}

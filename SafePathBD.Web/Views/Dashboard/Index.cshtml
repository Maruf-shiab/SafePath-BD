@model SafePathBD.Web.Models.ViewModels.Profile.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var profile = Model.Profile;
    var dashboard = Model.Dashboard;
    var firstName = profile.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? profile.FullName;
}

@section Head {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<partial name="_PageHeader" model="@(new PageHeaderViewModel
{
    Eyebrow = "Your safety workspace",
    Title = $"Welcome back, {firstName}",
    Description = dashboard.NeedsInfo > 0
        ? $"{dashboard.NeedsInfo} report{(dashboard.NeedsInfo == 1 ? " needs" : "s need")} your attention."
        : "Track your reports, review updates, and return to the map from one place.",
    Chips = profile.Roles.Select(r => new PageHeaderChip(r, r == RoleNames.Admin ? "chip--accent" : "chip--muted")).ToList()
})" />

<section class="section section--tight">
    <div class="shell dashboard-layout">
        <div class="dashboard-main stack-5">
            @if (dashboard.ActionRequired.Count > 0)
            {
                <section class="dashboard-focus" data-reveal>
                    <div class="dashboard-focus-head">
                        <div>
                            <span class="t-eyebrow">Action required</span>
                            <h2 class="t-h2">A reviewer needs more information</h2>
                        </div>
                        <span class="dashboard-focus-count" data-countup="@dashboard.ActionRequired.Count">@dashboard.ActionRequired.Count</span>
                    </div>
                    <div class="action-required-list">
                        @foreach (var item in dashboard.ActionRequired)
                        {
                            <a class="action-required-item" asp-controller="Reports" asp-action="Details" asp-route-id="@item.ReportId">
                                <div>
                                    <strong>@item.Title</strong>
                                    <p>@(string.IsNullOrWhiteSpace(item.ReviewerNote) ? "Open the report to review the moderator request." : item.ReviewerNote)</p>
                                </div>
                                <span>@item.UpdatedAt.ToString("d MMM, HH:mm")</span>
                            </a>
                        }
                    </div>
                </section>
            }

            <section class="panel dashboard-status" data-reveal>
                <div class="dashboard-section-head">
                    <div>
                        <span class="t-eyebrow">Report status</span>
                        <h2 class="t-h3">Your reporting activity</h2>
                    </div>
                    <a class="btn btn-ghost" asp-controller="Reports" asp-action="My">View all reports</a>
                </div>

                <div class="dashboard-metrics" aria-label="Report metrics">
                    <div class="dashboard-metric dashboard-metric--primary">
                        <span class="dashboard-metric-value" data-countup="@dashboard.TotalReports">@dashboard.TotalReports</span>
                        <span class="dashboard-metric-label">Total reports</span>
                    </div>
                    <div class="dashboard-metric">
                        <span class="dashboard-metric-value" data-countup="@(dashboard.Pending + dashboard.UnderReview)">@(dashboard.Pending + dashboard.UnderReview)</span>
                        <span class="dashboard-metric-label">Awaiting review</span>
                    </div>
                    <div class="dashboard-metric dashboard-metric--attention">
                        <span class="dashboard-metric-value" data-countup="@dashboard.NeedsInfo">@dashboard.NeedsInfo</span>
                        <span class="dashboard-metric-label">Needs information</span>
                    </div>
                    <div class="dashboard-metric dashboard-metric--safe">
                        <span class="dashboard-metric-value" data-countup="@dashboard.Verified">@dashboard.Verified</span>
                        <span class="dashboard-metric-label">Verified</span>
                    </div>
                    <div class="dashboard-metric">
                        <span class="dashboard-metric-value" data-countup="@dashboard.Resolved">@dashboard.Resolved</span>
                        <span class="dashboard-metric-label">Resolved</span>
                    </div>
                </div>
            </section>

            <section class="panel" data-reveal>
                <div class="dashboard-section-head">
                    <div>
                        <span class="t-eyebrow">Recent reports</span>
                        <h2 class="t-h3">Latest submissions</h2>
                    </div>
                </div>
                @if (dashboard.RecentReports.Count == 0)
                {
                    <div class="empty-state">
                        <h3 class="t-h3">No reports yet</h3>
                        <p class="t-body">Help make nearby roads safer by reporting an accident or hazard.</p>
                        <div class="cluster">
                            <a class="btn btn-primary" asp-controller="Reports" asp-action="Accident">Report accident</a>
                            <a class="btn btn-secondary" asp-controller="Reports" asp-action="Hazard">Report hazard</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="report-list dashboard-report-list">
                        @foreach (var report in dashboard.RecentReports)
                        {
                            <partial name="_ReportCard" model="report" />
                        }
                    </div>
                }
            </section>

            <section class="panel" data-reveal>
                <div class="dashboard-section-head">
                    <div>
                        <span class="t-eyebrow">Recent activity</span>
                        <h2 class="t-h3">What changed</h2>
                    </div>
                </div>
                @if (dashboard.RecentActivity.Count == 0)
                {
                    <div class="empty-state"><p class="t-body">Your recent report and notification activity will appear here.</p></div>
                }
                else
                {
                    <div class="dashboard-timeline">
                        @foreach (var activity in dashboard.RecentActivity)
                        {
                            <div class="dashboard-timeline-item">
                                <span class="dashboard-timeline-dot" aria-hidden="true"></span>
                                <div>
                                    <strong>@activity.Title</strong>
                                    <p>@activity.Description</p>
                                    <span class="t-micro t-muted">@activity.OccurredAt.ToString("d MMM yyyy, HH:mm")</span>
                                </div>
                                @if (activity.ReportId is not null)
                                {
                                    <a class="btn btn-ghost" asp-controller="Reports" asp-action="Details" asp-route-id="@activity.ReportId">Open</a>
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <aside class="dashboard-side stack-5">
            <section class="panel dashboard-actions" data-reveal>
                <span class="t-eyebrow">Quick actions</span>
                <div class="dashboard-action-grid">
                    <a asp-controller="Map" asp-action="Index"><span>Map</span><small>Explore verified reports</small></a>
                    <a asp-controller="Reports" asp-action="Accident"><span>Accident</span><small>Submit a road incident</small></a>
                    <a asp-controller="Reports" asp-action="Hazard"><span>Hazard</span><small>Report a road danger</small></a>
                    <a asp-controller="Map" asp-action="Index" asp-fragment="emergency"><span>Emergency</span><small>Find nearby services</small></a>
                </div>
            </section>

            <section class="panel" data-reveal>
                <div class="dashboard-section-head">
                    <div>
                        <span class="t-eyebrow">Notifications</span>
                        <h2 class="t-h3">Latest updates</h2>
                    </div>
                    @if (dashboard.UnreadNotifications > 0)
                    {
                        <span class="chip chip--accent">@dashboard.UnreadNotifications unread</span>
                    }
                </div>
                @if (dashboard.RecentNotifications.Count == 0)
                {
                    <div class="dashboard-compact-empty">You're all caught up.</div>
                }
                else
                {
                    <div class="dashboard-notification-list">
                        @foreach (var notification in dashboard.RecentNotifications)
                        {
                            <a class="dashboard-notification @(notification.IsRead ? "is-read" : "is-unread")"
                               data-notification-link data-notification-id="@notification.NotificationId" data-notification-read="@(notification.IsRead ? "1" : "0")"
                               href="@(notification.ActionUrl ?? Url.Action("Index", "Notifications"))">
                                <span></span>
                                <div>
                                    <strong>@notification.Title</strong>
                                    <p>@notification.Message</p>
                                </div>
                            </a>
                        }
                    </div>
                }
                <a class="btn btn-secondary btn-block" asp-controller="Notifications" asp-action="Index">Open notifications</a>
            </section>

            <section class="panel" data-reveal>
                <div class="identity" style="margin-bottom: var(--space-5);">
                    <span class="avatar" aria-hidden="true">@profile.Initials</span>
                    <div class="stack-2">
                        <strong>@profile.FullName</strong>
                        <span class="t-meta">@profile.Email</span>
                    </div>
                </div>
                <dl class="detail-list">
                    <div class="detail-row"><dt>Account</dt><dd><span class="chip @(profile.IsActive ? "chip--safe" : "chip--danger")">@(profile.IsActive ? "Active" : "Deactivated")</span></dd></div>
                    <div class="detail-row"><dt>Member since</dt><dd>@profile.JoinedAt.ToString("d MMM yyyy")</dd></div>
                </dl>
                <a class="btn btn-secondary btn-block" asp-controller="Profile" asp-action="Index" style="margin-top: var(--space-5);">View profile</a>
            </section>

            @if (User.IsInRole(RoleNames.Moderator) || User.IsInRole(RoleNames.Admin))
            {
                <section class="panel dashboard-role-panel" data-reveal>
                    <span class="t-eyebrow">Review operations</span>
                    <h3 class="t-h3">Moderation workspace</h3>
                    <p class="t-body">See the live review queue and recent moderation activity.</p>
                    <a class="btn btn-primary btn-block" asp-area="Admin" asp-controller="ModeratorDashboard" asp-action="Index">Open moderation dashboard</a>
                </section>
            }
        </aside>
    </div>
</section>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true" defer></script>
}

@using System.Globalization
@{
    ViewData["Title"] = "Smart road safety";

    var factors = new (string Label, string Detail, int Percent)[]
    {
        ("Historical accidents", "Verified accident records on the segment", 35),
        ("Active hazards", "Confirmed potholes, waterlogging, blockages", 25),
        ("Road condition", "Surface, drainage and visibility scores", 15),
        ("Traffic", "Congestion level and average speed", 10),
        ("Weather", "Rainfall and visibility risk", 10),
        ("Lighting", "Night-time street lighting quality", 5)
    };
}

<section class="hero">
    <div class="grid-backdrop" aria-hidden="true"></div>
    <div class="shell hero-inner">
        <div class="hero-copy">
            <span class="t-eyebrow">Road safety intelligence</span>

            <h1 class="t-display hero-title">
                Choose more than the fastest road.
                <em>Understand the safer one.</em>
            </h1>

            <p class="t-lead">
                SafePath BD scores individual road segments using verified accidents, active hazards,
                road condition, traffic, weather and lighting — then recommends a safer route beside
                the fastest and shortest alternatives.
            </p>

            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">
                    Create an account
                    <svg class="btn-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h13M13 6l6 6-6 6" />
                    </svg>
                </a>
                <a class="btn btn-secondary btn-lg" href="#how-it-works">See how it works</a>
            </div>

            <div class="hero-notes">
                <span class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Segment-level scoring, not whole roads
                </span>
                <span class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Every score is explainable
                </span>
                <span class="hero-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                    Reports are reviewed before they count
                </span>
            </div>
        </div>

        <div class="route-visual" data-parallax role="img"
             aria-label="A route crossing a road network, passing safety checkpoints between a start and a destination point.">
            <svg viewBox="0 0 480 480" aria-hidden="true" focusable="false">
                <defs>
                    <linearGradient id="rvRouteGradient" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0%" stop-color="#4ce0ca" />
                        <stop offset="60%" stop-color="#35d0ba" />
                        <stop offset="100%" stop-color="#14a894" />
                    </linearGradient>
                </defs>

                <g class="rv-grid">
                    <path d="M0 60H480M0 140H480M0 220H480M0 300H480M0 380H480" />
                    <path d="M60 0V480M140 0V480M220 0V480M300 0V480M380 0V480" />
                </g>

                <g class="rv-road">
                    <path d="M-10 140H200L260 200V470" />
                    <path d="M490 300H320L250 230" />
                    <path d="M60 -10V180L120 240V490" />
                    <path d="M400 -10V120L340 180V420" />
                </g>

                <path class="rv-alt" d="M78 392C78 300 150 268 210 268 300 268 330 210 330 132" />

                <path class="rv-route" data-route-path
                      d="M78 392C78 330 118 300 168 296 232 292 246 250 252 206 258 158 292 132 344 132" />

                @* Positioning stays on the outer group so the CSS scale animation cannot replace it. *@
                <g transform="translate(78 392)">
                    <g class="rv-node" style="--node-delay: 1550ms">
                        <circle class="rv-node-ring" r="13" />
                        <circle class="rv-node-core" r="6" />
                    </g>
                </g>
                <g transform="translate(168 296)">
                    <g class="rv-node rv-node--risk" style="--node-delay: 1900ms">
                        <circle class="rv-node-ring" r="10" />
                        <circle class="rv-node-core" r="4.5" />
                    </g>
                </g>
                <g transform="translate(252 206)">
                    <g class="rv-node" style="--node-delay: 2150ms">
                        <circle class="rv-node-ring" r="10" />
                        <circle class="rv-node-core" r="4.5" />
                    </g>
                </g>
                <g transform="translate(344 132)">
                    <g class="rv-node" style="--node-delay: 2400ms">
                        <circle class="rv-node-ring" r="13" />
                        <circle class="rv-node-core" r="6" />
                    </g>
                </g>
            </svg>

            <div class="route-legend">
                <span class="chip chip--accent">Safest route</span>
                <span class="chip chip--caution">Segment needing attention</span>
                <span class="chip chip--muted chip--plain">Alternative path</span>
            </div>
        </div>
    </div>
</section>

<section class="section" id="how-it-works">
    <div class="shell">
        <div class="section-head" data-reveal>
            <span class="t-eyebrow">How SafePath BD works</span>
            <h2 class="t-h2">From a raw route to a safety-aware recommendation</h2>
            <p class="t-lead">
                A journey is broken into the road segments it actually travels. A route is only as safe
                as the sections it passes through.
            </p>
        </div>

        <div class="split">
            <ol class="step-list">
                <li class="step" data-reveal="stagger">
                    <span class="step-index">01</span>
                    <div>
                        <h3 class="t-h3 card-title">Pick a start and destination</h3>
                        <p class="t-body">Candidate routes are requested from a routing provider, including alternatives.</p>
                    </div>
                </li>
                <li class="step" data-reveal="stagger">
                    <span class="step-index">02</span>
                    <div>
                        <h3 class="t-h3 card-title">Match the route to road segments</h3>
                        <p class="t-body">Each candidate is aligned with the road segments SafePath BD already tracks.</p>
                    </div>
                </li>
                <li class="step" data-reveal="stagger">
                    <span class="step-index">03</span>
                    <div>
                        <h3 class="t-h3 card-title">Score every segment</h3>
                        <p class="t-body">Accidents, hazards, condition, traffic, weather and lighting produce a 0–100 score.</p>
                    </div>
                </li>
                <li class="step" data-reveal="stagger">
                    <span class="step-index">04</span>
                    <div>
                        <h3 class="t-h3 card-title">Compare and explain</h3>
                        <p class="t-body">Safest, fastest and shortest sit side by side with the reasoning behind each score.</p>
                    </div>
                </li>
            </ol>

            <div class="panel" data-reveal>
                <span class="t-eyebrow">Why segments</span>
                <h3 class="t-h3" style="margin-block: var(--space-3);">One road is rarely uniformly safe</h3>
                <p class="t-body">
                    A highway can be well lit and well drained for ten kilometres and then pass through an
                    intersection with a history of collisions. Scoring whole roads hides that. SafePath BD
                    divides roads into segments so a single risky stretch stays visible instead of being
                    averaged away.
                </p>
                <div class="cluster" style="margin-top: var(--space-5);">
                    <span class="chip chip--safe">Low risk</span>
                    <span class="chip chip--caution">Moderate risk</span>
                    <span class="chip chip--danger">High risk</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section--tight" id="community">
    <div class="shell">
        <div class="section-head" data-reveal>
            <span class="t-eyebrow">Community road safety</span>
            <h2 class="t-h2">Reports become trusted data only after review</h2>
            <p class="t-lead">
                Anyone signed in can report what they see on the road. Nothing influences a safety score
                until a moderator or administrator has reviewed it.
            </p>
        </div>

        <div class="tile-grid">
            <article class="card card--interactive" data-reveal="stagger">
                <span class="card-icon card-icon--danger" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /></svg>
                </span>
                <h3 class="t-h3 card-title">Accident reports</h3>
                <p class="t-body">Type, severity, time, vehicles and casualties, submitted with a map location.</p>
            </article>

            <article class="card card--interactive" data-reveal="stagger">
                <span class="card-icon card-icon--caution" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h18" /><path d="M6 17V9l6-4 6 4v8" /><path d="M10 17v-4h4v4" /></svg>
                </span>
                <h3 class="t-h3 card-title">Hazard reports</h3>
                <p class="t-body">Potholes, waterlogging, broken signals, blockages and dangerous intersections.</p>
            </article>

            <article class="card card--interactive" data-reveal="stagger">
                <span class="card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9.5" cy="7" r="4" /><path d="m17 11 2 2 4-4" /></svg>
                </span>
                <h3 class="t-h3 card-title">Community confirmation</h3>
                <p class="t-body">Other travellers confirm or dispute a report and add context in comments.</p>
            </article>

            <article class="card card--interactive" data-reveal="stagger">
                <span class="card-icon card-icon--info" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11.5 11.2 13.7 15.4 9.3" /><path d="M20.5 12a8.5 8.5 0 1 1-17 0 8.5 8.5 0 0 1 17 0Z" /></svg>
                </span>
                <h3 class="t-h3 card-title">Moderator verification</h3>
                <p class="t-body">Every decision is recorded, so a report's history stays auditable.</p>
            </article>
        </div>
    </div>
</section>

<section class="section" id="safety-engine">
    <div class="shell split">
        <div data-reveal>
            <span class="t-eyebrow">Safety scoring</span>
            <h2 class="t-h2" style="margin-block: var(--space-3) var(--space-4);">A score you can take apart</h2>
            <p class="t-lead">
                Each segment score is stored together with the contribution of every factor, so a
                recommendation can be explained rather than trusted blindly. The weights below are the
                project's configured defaults and can be tuned by an administrator.
            </p>
            <p class="t-meta" style="margin-top: var(--space-5);">
                Weighted risk is subtracted from 100 to produce the final 0–100 segment safety score.
            </p>
        </div>

        <div class="panel" data-reveal>
            @foreach (var factor in factors)
            {
                var scale = (factor.Percent / 100.0).ToString("0.00", CultureInfo.InvariantCulture);
                <div class="factor-row" data-reveal style="--factor-scale: @scale">
                    <div class="factor-label">
                        <span>@factor.Label</span>
                        <span class="factor-track"><span class="factor-fill"></span></span>
                        <span class="t-meta">@factor.Detail</span>
                    </div>
                    <span class="factor-value">@factor.Percent%</span>
                </div>
            }
        </div>
    </div>
</section>

<section class="section section--tight" id="emergency">
    <div class="shell split">
        <div class="panel" data-reveal>
            <span class="card-icon card-icon--danger" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
            <h3 class="t-h3 card-title">Nearby emergency services</h3>
            <p class="t-body">
                Hospitals, police stations, fire services, ambulances and emergency centres are searchable
                from a location, with contact numbers and opening hours.
            </p>
            <p class="t-meta" style="margin-top: var(--space-4);">
                SafePath BD surfaces contact information. It does not dispatch emergency services.
            </p>
        </div>

        <div data-reveal>
            <span class="t-eyebrow">Emergency assistance</span>
            <h2 class="t-h2" style="margin-block: var(--space-3) var(--space-4);">Help you can reach quickly</h2>
            <p class="t-lead">
                When something goes wrong, the information you need should already be on the screen —
                not several searches away.
            </p>
        </div>
    </div>
</section>

<section class="section section--tight">
    <div class="shell">
        <div class="cta-band" data-reveal>
            <div class="stack-3">
                <h2 class="t-h2">Start using SafePath BD</h2>
                <p class="t-body" style="max-width: 46ch;">
                    Create an account to save places, submit reports and receive route recommendations
                    as each module becomes available.
                </p>
            </div>
            <div class="cluster">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create account</a>
                <a class="btn btn-secondary btn-lg" asp-controller="Account" asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>
</section>

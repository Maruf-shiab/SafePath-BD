# ---------------------------------------------------------------------------
# SafePath BD — .NET / ASP.NET Core .gitignore
# ---------------------------------------------------------------------------

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
build/
bld/
artifacts/
publish/
[Pp]ublish[Oo]utput/

# Visual Studio / Rider / VS Code
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.svclog
*.psess
*.vsp
*.vspx

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# Test / coverage results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/

# Secrets and local configuration — NEVER COMMIT
# The MySQL password lives in .NET User Secrets, outside this repository.
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.key
*.pem
.env
.env.*

# Logs
logs/
*.log

# User uploaded content (report images).
# Stored outside wwwroot so it is never served by the static-file middleware.
**/storage/report-images/
**/wwwroot/uploads/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Misc
*.tmp
*.bak
*.cache
node_modules/
